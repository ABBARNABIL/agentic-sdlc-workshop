{
  "name": "agentic-sdlc-workshop-guide",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "prebuild": "node scripts/licenses.mjs",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --test tests/*.test.ts",
    "check:links": "node scripts/check-links.mjs",
    "validate": "npm test && npm run check && npm run build && npm run check:links"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "astro": "7.3.8",
    "hast-util-to-string": "3.0.1",
    "mermaid": "12.2.0",
    "rehype-sanitize": "6.0.0",
    "rehype-slug": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/hast": "3.0.4",
    "@types/node": "24.7.2",
    "cheerio": "1.2.0",
    "typescript": "5.9.3"
  }
}
